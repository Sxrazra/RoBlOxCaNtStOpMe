local brightLoop -- 用來存儲循環事件
local isFullbrightEnabled = false -- 初始狀態為關閉

local function startFullbright()
    if isFullbrightEnabled then return end -- 防止重複啟動
    isFullbrightEnabled = true
    local Lighting = game:GetService("Lighting")
    brightLoop = game:GetService("RunService").RenderStepped:Connect(function()
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.FogEnd = 100000
        Lighting.GlobalShadows = false
        Lighting.OutdoorAmbient = Color3.fromRGB(128, 128, 128)
    end)
end

local function stopFullbright()
    if not isFullbrightEnabled then return end -- 防止重複關閉
    isFullbrightEnabled = false
    if brightLoop then
        brightLoop:Disconnect()
        brightLoop = nil
    end
    local Lighting = game:GetService("Lighting")
    Lighting.Brightness = 1 -- 恢復默認亮度
    Lighting.ClockTime = 12 -- 恢復默認時間
    Lighting.FogEnd = 1000 -- 恢復默認霧距離
    Lighting.GlobalShadows = true -- 開啟陰影
    Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255) -- 恢復默認環境光
end

local Toggle1 = PageSection2:Toggle({
